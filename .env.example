# URL pública do site, sem barra final. Troque pelo domínio HTTPS antes do deploy.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form (server-side configuration; never use NEXT_PUBLIC_).
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Cloudflare Turnstile: the site key is public; the secret stays server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
